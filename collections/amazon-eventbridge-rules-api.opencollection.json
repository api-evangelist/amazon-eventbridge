        {
          "info": {
            "name": "Amazon EventBridge Delete Rule",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://events.{region}.amazonaws.com/?DeleteRule",
            "headers": [
              {
                "name": "X-Amz-Target",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
